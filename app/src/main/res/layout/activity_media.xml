<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MediaActivity">

    <TextView
        android:id="@+id/textView7"
        android:layout_width="411dp"
        android:layout_height="72dp"
        android:background="@color/esmeralda"
        android:gravity="center"
        android:text="Calcular Média"
        android:textColor="@color/lima"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/voltarbtn1"
        android:layout_width="82dp"
        android:layout_height="74dp"
        android:backgroundTint="@color/esmeralda"
        android:text="voltar"
        app:cornerRadius="0dp"
        app:icon="@drawable/outline_arrow_back_24"
        app:iconGravity="start"
        app:iconSize="30dp"
        app:iconTint="@color/lima"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="102dp"
        android:layout_height="94dp"
        android:layout_marginStart="152dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7"
        app:srcCompat="@drawable/outline_align_vertical_bottom_24" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="131dp"
        android:layout_marginTop="10dp"
        android:text="Digite as notas"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="82dp"
        android:layout_marginTop="18dp"
        android:text="Nota da Prova 1:"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView8" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="82dp"
        android:layout_marginTop="5dp"
        android:text="Nota da Prova 2:"
        android:textSize="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prova1edit" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="82dp"
        android:layout_marginTop="5dp"
        android:text="Nota do Trabalho:"
        android:textSize="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prova2edit" />

    <EditText
        android:id="@+id/prova1edit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="82dp"
        android:layout_marginTop="5dp"
        android:ems="10"
        android:hint="Digite a Nota"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView9" />

    <EditText
        android:id="@+id/prova2edit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="82dp"
        android:layout_marginTop="5dp"
        android:ems="10"
        android:hint="Digite a Nota"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView10" />

    <EditText
        android:id="@+id/atividadeedit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="82dp"
        android:layout_marginTop="5dp"
        android:ems="10"
        android:hint="Digite a Nota"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView12" />

    <EditText
        android:id="@+id/trabalhoedit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginStart="82dp"
        android:layout_marginTop="5dp"
        android:ems="10"
        android:hint="Digite a Nota"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView11" />

    <TextView
        android:id="@+id/textView12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="82dp"
        android:layout_marginTop="5dp"
        android:text="Nota do Atividade:"
        android:textSize="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/trabalhoedit" />

    <Button
        android:id="@+id/mediabtn"
        android:layout_width="169dp"
        android:layout_height="67dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/lima"
        android:text="Calcular"
        android:textColor="@color/esmeralda"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/atividadeedit" />

    <TextView
        android:id="@+id/resultadotxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="160dp"
        android:layout_marginTop="14dp"
        android:text="Resultado"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mediabtn" />

</androidx.constraintlayout.widget.ConstraintLayout>
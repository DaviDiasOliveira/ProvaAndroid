<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="411dp"
        android:layout_height="72dp"
        android:background="@color/esmeralda"
        android:gravity="center"
        android:text="Prova Android"
        android:textColor="@color/lima"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="117dp"
        android:layout_marginTop="67dp"
        android:text="Bem Vindo(a) à prova!"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="128dp"
        android:layout_marginTop="56dp"
        android:text="Descrição da Prova:"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="224dp"
        android:layout_height="44dp"
        android:layout_marginStart="93dp"
        android:layout_marginTop="28dp"
        android:text="Desenvolva um aplicativo com duas funcionalidades:"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="222dp"
        android:layout_height="41dp"
        android:layout_marginStart="93dp"
        android:layout_marginTop="10dp"
        android:text="1. Calcular Média Final do aluno(com base nas notas)."
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="227dp"
        android:layout_height="61dp"
        android:layout_marginStart="92dp"
        android:layout_marginTop="10dp"
        android:text="2. Cadastrar Nome, Ra e Email do aluno e salvar na persistência."
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <Button
        android:id="@+id/calcularbtn"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:layout_marginStart="109dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="@color/lima"
        android:text="Calcular Média"
        android:textColor="@color/esmeralda"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/outline_align_vertical_bottom_24"
        app:iconSize="24dp"
        app:iconTint="@color/esmeralda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView6" />

    <Button
        android:id="@+id/cadastrarbtn"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:layout_marginStart="105dp"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/cha"
        android:text="Cadastrar Aluno"
        android:textColor="@color/esmeralda"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/outline_article_person_24"
        app:iconSize="24dp"
        app:iconTint="@color/esmeralda"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calcularbtn" />
</androidx.constraintlayout.widget.ConstraintLayout>